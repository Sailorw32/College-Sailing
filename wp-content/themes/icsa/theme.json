{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#F3F5F2" },
        { "slug": "paper-raised", "name": "Paper Raised", "color": "#FFFFFF" },
        { "slug": "ink", "name": "Ink", "color": "#10222E" },
        { "slug": "ink-soft", "name": "Ink Soft", "color": "#48565F" },
        { "slug": "navy", "name": "Navy", "color": "#163A5C" },
        { "slug": "navy-deep", "name": "Navy Deep", "color": "#0C2740" },
        { "slug": "signal", "name": "Signal Red", "color": "#D33A2C" },
        { "slug": "teal", "name": "Sea Teal", "color": "#2A6763" },
        { "slug": "rule", "name": "Rule", "color": "#D7DCDB" }
      ],
      "custom": true,
      "customDuotone": false,
      "customGradient": false
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "'Oswald', 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, 'SF Mono', 'Cascadia Code', 'Roboto Mono', Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "caption", "name": "Caption", "size": "0.8125rem" },
        { "slug": "body", "name": "Body", "size": "1rem" },
        { "slug": "lead", "name": "Lead", "size": "1.25rem" },
        { "slug": "heading", "name": "Heading", "size": "1.75rem" },
        { "slug": "title", "name": "Title", "size": "2.5rem" },
        { "slug": "display", "name": "Display", "size": "clamp(2.75rem, 5vw, 4rem)" }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "1rem" },
        { "slug": "30", "name": "M", "size": "1.5rem" },
        { "slug": "40", "name": "L", "size": "2.5rem" },
        { "slug": "50", "name": "XL", "size": "4rem" },
        { "slug": "60", "name": "XXL", "size": "6rem" }
      ],
      "units": ["px", "rem", "%", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "letterSpacing": "-0.01em"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--navy)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--signal)" } }
      },
      "button": {
        "color": {
          "text": "var(--wp--preset--color--paper)",
          "background": "var(--wp--preset--color--navy)"
        },
        "border": { "radius": "3px" },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--signal)" }
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--title)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "area": "header" },
    { "name": "footer", "area": "footer" }
  ],
  "customTemplates": []
}
